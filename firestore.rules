rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // AI Profiles: Users can only access their own profile.
    match /aiProfiles/{uid} {
      allow read, update, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null;

      // Sessions: Users can manage their own sessions.
      match /sessions/{sessionId} {
        allow read, write, create, delete: if request.auth != null && request.auth.uid == uid;

        // Messages: Users can manage messages within their own sessions.
        match /messages/{messageId} {
          allow read, write, create, delete: if request.auth != null && request.auth.uid == uid;
        }

        // Calls: Users can manage calls within their own sessions.
        match /calls/{callId} {
            allow read, write, create, delete: if request.auth != null && request.auth.uid == uid;
        }
      }
    }
  }
}
