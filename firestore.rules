rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // AI data root — user-scoped access
    match /aiProfiles/{uid} {
      // Only the authenticated owner can read/write their profile
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // sessions subcollection
      match /sessions/{sid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;

        // messages subcollection
        match /messages/{mid} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }
      }

      // usage subcollection: read by owner; writes only via backend
      match /usage/{month} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null
                     && request.auth.token.admin == true; // set via Cloud Functions
      }
    }

    // subscriptions managed by server/webhooks
    match /subscriptions/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
