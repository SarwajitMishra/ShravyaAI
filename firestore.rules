rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users can create, read, and update their own profile.
    // They cannot see or edit other users' profiles.
    match /aiProfiles/{userId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;

      // Users can manage their own chat sessions.
      match /sessions/{sessionId} {
        allow read, write, create, delete: if request.auth != null && request.auth.uid == userId;

        // Users can manage the messages and call logs within their own sessions.
        match /messages/{messageId} {
          allow read, write, create, delete: if request.auth != null && request.auth.uid == userId;
        }
        match /calls/{callId} {
           allow read, write, create, delete: if request.auth != null && request.auth.uid == userId;
        }
      }
    }
  }
}
